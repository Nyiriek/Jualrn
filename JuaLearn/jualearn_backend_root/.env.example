DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Keep this value on the server only. Never expose it in a VITE_ variable or
# commit a real key to source control.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
FRONTEND_URL=http://localhost:3000
# Local development prints verification codes in the Django terminal. For real
# delivery, use django.core.mail.backends.smtp.EmailBackend and SMTP values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=JuaLearn <no-reply@example.com>
EMAIL_VERIFICATION_HOURS=24
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
